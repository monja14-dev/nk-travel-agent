# Copy this file to .env.local (or set these in Vercel's Project Settings →
# Environment Variables) and fill in real values. Never commit a file with
# real values — .gitignore already excludes .env and .env.* except this one.
#
# These two are read ONLY by api/ai-chat.ts (the Vercel Edge Function),
# never by any file under src/. They are not exposed to the browser bundle:
# Vite only inlines variables prefixed VITE_ into client code, and nothing
# under src/ reads process.env.ANTHROPIC_* — api/_lib/__tests__/noClientLeak.test.ts
# enforces that boundary automatically.

# Secret key for the Anthropic Messages API (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Model name to call, e.g. claude-opus-4-5-20251101 (see
# https://docs.claude.com/en/docs/about-claude/models for current IDs).
ANTHROPIC_MODEL=
